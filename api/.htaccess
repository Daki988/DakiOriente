# contact.php, candidature.php, audit.php et chat.php sont appelés par le site ; les réglages restent privés
<FilesMatch "^(config|config\.sample|mailer)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
