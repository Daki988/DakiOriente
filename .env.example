# ---------- Application ----------
APP_NAME="Tremplin by NEAM"
APP_URL=
APP_DEBUG=false
# Affiche les comptes de démonstration sur la page de connexion
APP_DEMO=true
APP_TIMEZONE=Africa/Libreville

# ---------- Base de données ----------
# sqlite (par défaut, zéro configuration) | mysql | pgsql
DB_DRIVER=sqlite
# DB_PATH=/chemin/vers/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=tremplin
# DB_USER=tremplin
# DB_PASSWORD=

# ---------- Notifications ----------
# log : messages tracés dans le back-office (Communications)
# smtp : envoi réel depuis la boîte NEAM (recommandé en production)
# mail : fonction mail() de PHP
MAIL_DRIVER=log
MAIL_FROM=contact@neamindustry.com
MAIL_FROM_NAME="Tremplin by NEAM"
# Paramètres SMTP de la boîte contact@neamindustry.com (fournis par l'hébergeur de la messagerie)
MAIL_HOST=
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=contact@neamindustry.com
MAIL_PASSWORD=
SMS_DRIVER=log

# ---------- Intelligence artificielle ----------
# Claude rédige les CV, lettres de motivation et la préparation d'entretien.
# Clé à créer sur https://console.anthropic.com (Settings > API Keys). Sans clé, le moteur local prend le relais.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ---------- Paiements ----------
# Paiements désactivés pendant la phase de lancement (réglable dans Admin > Paramètres).
# sandbox : simulation Airtel Money / Moov Money / carte, pour les tests uniquement
PAYMENT_DRIVER=sandbox

UPLOAD_MAX_SIZE=5242880
