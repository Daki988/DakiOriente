# Navigoal — configuration de production (copier en .env à la racine de l'application, ou saisir dans cPanel > Setup Node.js App)

# Adresse publique du site
NEXT_PUBLIC_SITE_URL=https://navigoal.net
APP_URL=https://navigoal.net

# Base PostgreSQL : chaîne de connexion Neon (offres cPanel M, L, XL), par exemple
#   postgresql://navigoal_owner:MOT_DE_PASSE@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# ou, sur une offre Cloud cPanel : postgres://UTILISATEUR:MOT_DE_PASSE@localhost:5432/NOM_DE_LA_BASE
DATABASE_URL=

# Fichiers déposés (pièces des dossiers, photos d'annonces) : dossier hors public_html
STORAGE_DIR=/home/IDENTIFIANT_CPANEL/navigoal/stockage

# E-mails : compte contact@navigoal.net créé dans cPanel > Comptes de messagerie
SMTP_HOST=mail.navigoal.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@navigoal.net
SMTP_PASS=MOT_DE_PASSE_DE_LA_BOITE
MAIL_FROM="Navigoal <contact@navigoal.net>"
MAIL_REPLY_TO=contact@navigoal.net

# Connexion avec Google (optionnel : le bouton n'apparaît que si les deux valeurs sont renseignées).
# Console Google Cloud > API et services > Identifiants > ID client OAuth (application Web).
# URI de redirection autorisée : https://navigoal.net/api/auth/google/retour/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Paiements : « sandbox » pendant l'essai ; CinetPay en production (clés du compte marchand).
# En mode sandbox, seul un administrateur confirme un paiement (après réception d'un virement ou d'un mobile money).
# Ne JAMAIS mettre ALLOW_SANDBOX_PAYMENTS=1 sur le site public : chacun pourrait valider ses paiements sans payer.
PAYMENTS_MODE=sandbox
CINETPAY_SITE_ID=
CINETPAY_API_KEY=

# Bouton « Une question ? » (WhatsApp des conseillers) : numéro avec indicatif, sans espaces ni « + » (ex. 24107000000).
# Vide : le bouton n'apparaît pas. Lu à chaque requête : pas besoin de reconstruire le site pour le changer.
WHATSAPP_CONSEILLER=

# SMS (optionnel) : URL d'un service d'envoi qui reçoit {to, text} en POST
SMS_WEBHOOK_URL=

# Surveillance : adresse qui reçoit une alerte en cas d'erreur serveur (une par type d'erreur et par quart d'heure)
ALERTE_EMAIL=

# Sauvegardes (npm run sauvegarde, tâche cron quotidienne) : dossier, nombre conservé, copie par e-mail hors du serveur
SAUVEGARDE_DOSSIER=/home/IDENTIFIANT_CPANEL/navigoal/sauvegardes
SAUVEGARDE_GARDER=14
SAUVEGARDE_EMAIL=

# Laisser vide en production (affiche les codes de vérification dans la réponse si = 1)
OTP_DEBUG=
