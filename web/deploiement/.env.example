# Navigoal — configuration de production (copier en .env à la racine de l'application, ou saisir dans cPanel > Setup Node.js App)

# Adresse publique du site
NEXT_PUBLIC_SITE_URL=https://navigoal.net
APP_URL=https://navigoal.net

# Base PostgreSQL créée dans cPanel > Bases de données PostgreSQL (utilisateur et base préfixés par l'identifiant cPanel)
DATABASE_URL=postgres://UTILISATEUR:MOT_DE_PASSE@localhost:5432/NOM_DE_LA_BASE

# Fichiers déposés (pièces des dossiers, photos d'annonces) : dossier hors public_html
STORAGE_DIR=/home/IDENTIFIANT_CPANEL/navigoal/stockage

# E-mails : compte contact@navigoal.net créé dans cPanel > Comptes de messagerie
SMTP_HOST=mail.navigoal.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@navigoal.net
SMTP_PASS=MOT_DE_PASSE_DE_LA_BOITE
MAIL_FROM=Navigoal <contact@navigoal.net>
MAIL_REPLY_TO=contact@navigoal.net

# Connexion avec Google (optionnel : le bouton n'apparaît que si les deux valeurs sont renseignées).
# Console Google Cloud > API et services > Identifiants > ID client OAuth (application Web).
# URI de redirection autorisée : https://navigoal.net/api/auth/google/retour/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Paiements : « sandbox » pendant l'essai ; CinetPay en production (clés du compte marchand)
PAYMENTS_MODE=sandbox
ALLOW_SANDBOX_PAYMENTS=1
CINETPAY_SITE_ID=
CINETPAY_API_KEY=

# SMS (optionnel) : URL d'un service d'envoi qui reçoit {to, text} en POST
SMS_WEBHOOK_URL=

# Laisser vide en production (affiche les codes de vérification dans la réponse si = 1)
OTP_DEBUG=
