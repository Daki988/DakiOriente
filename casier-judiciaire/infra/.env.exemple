# Copier en infra/.env (non versionné) et remplacer chaque valeur. Poste de développement uniquement.
CASIER_BD_MOT_DE_PASSE=a-remplacer
KEYCLOAK_ADMIN_MOT_DE_PASSE=a-remplacer
# Mot de passe commun des comptes de démonstration créés par keycloak/creer-comptes-demo.sh (ENV-04)
CASIER_MOT_DE_PASSE_DEMO=a-remplacer
# Clé partagée avec l’agrégateur de paiement (laisser vide en démonstration)
CASIER_PAIEMENT_SECRET=
# Secret du client Keycloak « casier-gestion-agents » (onglet Credentials), pour gérer les agents depuis la plateforme.
CASIER_AGENTS_SECRET=

# Connexion OpenID Connect du portail (pile complète). Laisser OIDC_EMETTEUR vide pour les comptes de démonstration.
# Exemple derrière un proxy HTTPS : OIDC_EMETTEUR=https://connexion.exemple.ga/realms/casier
OIDC_EMETTEUR=
PORTAIL_URL=http://localhost:3000

# Démonstration : paiement simulé par le portail et comptes de démonstration (à mettre à false en production).
PAIEMENT_SIMULE=true
COMPTES_DEMO=false
