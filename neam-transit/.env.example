# Secret de signature des sessions (obligatoire en production, 32+ caractères aléatoires)
SESSION_SECRET=
# Mot de passe de l'espace administrateur (obligatoire en production)
ADMIN_PASSWORD=
# Dossier des données (base SQLite + documents des transitaires). Par défaut : ./data
NEAM_DATA_DIR=
# 1 = charge des transitaires de DÉMONSTRATION (fictifs, signalés comme tels) au premier démarrage
NEAM_DEMO=0
# URL publique du site (liens dans les messages WhatsApp)
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Envoi des codes de connexion (SMS / WhatsApp) : URL d'un webhook qui reçoit {"to","message"} en POST.
# Vide = le code est écrit dans les journaux du serveur (et affiché à l'écran hors production).
OTP_WEBHOOK_URL=
OTP_WEBHOOK_TOKEN=
