{
  "name": "neam-super-app",
  "private": true,
  "version": "1.0.0",
  "description": "NEAM Super App — Plus proche de votre quotidien.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "cap:sync": "npm run build && cap sync",
    "android": "npm run build && cap sync android && cap open android",
    "ios": "npm run build && cap sync ios && cap open ios",
    "apk": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "build:embed": "tsc -b && VITE_ROUTER=memory vite build",
    "build:marchand": "tsc -b && VITE_APP=merchant vite build --outDir dist-marchand",
    "build:livreur": "tsc -b && VITE_APP=courier vite build --outDir dist-livreur",
    "build:admin": "tsc -b && VITE_APP=admin vite build --outDir dist-admin",
    "apk:marchand": "npm run build:marchand && cd native/marchand && npx cap sync android && cd android && ./gradlew assembleDebug",
    "apk:livreur": "npm run build:livreur && cd native/livreur && npx cap sync android && cd android && ./gradlew assembleDebug",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "test:backend": "node scripts/test-backend.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/poppins": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "supabase": "^2.121.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
