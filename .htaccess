# NEAM Softwares Industry — configuration Apache (hébergement LWS)

# Page d'accueil et pas de liste des fichiers
DirectoryIndex index.html index.php
Options -Indexes

# Page introuvable personnalisée
ErrorDocument 404 /404.html

# L'ancienne page Super App est désormais dans Produits
Redirect 301 /super-app.html /produits.html#super-app

# Une seule adresse pour Google : https://www.neamindustry.com
# (le certificat SSL est actif sur neamindustry.com et www.neamindustry.com)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^neamindustry\.com$ [NC]
  RewriteRule ^(.*)$ https://www.neamindustry.com/$1 [L,R=301]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://www.neamindustry.com/$1 [L,R=301]
</IfModule>

# Manifeste de l'application (icône sur l'écran d'accueil)
AddType application/manifest+json .webmanifest
AddType image/webp .webp
AddType video/mp4 .mp4

# Compression des fichiers texte
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

# Mise en cache dans le navigateur
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType application/pdf "access plus 7 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>

# En-têtes de sécurité
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Politique de sécurité du contenu : empêche le chargement de plugins/objets, verrouille la
  # balise <base>, interdit que le site soit mis dans une iframe, et limite les cibles des formulaires.
  # NB : le site utilise des scripts en ligne ; une restriction script-src complète les casserait,
  # elle demanderait de sortir ces scripts dans des fichiers. Ici on durcit sans rien casser.
  Header always set Content-Security-Policy "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self' https://wa.me https://api.whatsapp.com; upgrade-insecure-requests"
</IfModule>
